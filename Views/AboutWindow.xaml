<Window x:Class="ShadeFlow.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ShadeFlow.Services" ui:UiMotion.Scope="True"
        Title="Informações e diagnóstico" Style="{StaticResource DialogWindow}" Icon="../Assets/ShadeFlow.ico"
        Width="620" SizeToContent="Height" MaxHeight="680" WindowStartupLocation="CenterOwner">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ShadeBorderBrush}" Background="{DynamicResource ShadeSurfaceBrush}">
            <StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ShadeDangerBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />
                <Button Content="Fechar" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource DialogPadding}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static ui:AppIcons.Info}" Style="{StaticResource FluentIcon}" Margin="0,0,12,0" />
                <TextBlock Text="Informações e diagnóstico" Style="{StaticResource DialogHeading}" />
            </StackPanel>
            <TextBlock Text="Versão, licença e informações locais para suporte." Style="{StaticResource MutedText}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Margin="0,0,0,24">
            <StackPanel Margin="24,0">
                <TextBlock x:Name="ReportText" TextWrapping="Wrap" />
                <Button Content="Copiar diagnóstico" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CopyDiagnosticsClick" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
