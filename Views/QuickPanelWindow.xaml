<Window x:Class="ShadeFlow.Views.QuickPanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:ShadeFlow.Services" xmlns:ui="clr-namespace:ShadeFlow.Services" motion:UiMotion.Scope="True"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ShadeFlow" Style="{StaticResource {x:Type Window}}" Width="370" SizeToContent="Height" MaxHeight="620"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize" ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="True"
        Deactivated="WindowDeactivated" PreviewKeyDown="WindowPreviewKeyDown" Loaded="WindowLoaded">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Border shell:WindowChrome.IsHitTestVisibleInChrome="True" CornerRadius="12" Background="{DynamicResource ShadeQuickTintBrush}" BorderBrush="{DynamicResource ShadeBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource ShadeBorderBrush}" BorderThickness="0,0,0,1" Padding="17,0,12,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Restaurar brilho para 100%" Click="RestoreClick" AutomationProperties.Name="Restaurar brilho para 100%">
                            <TextBlock Text="{x:Static ui:AppIcons.Restore}" Style="{StaticResource FluentIcon}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Abrir configurações" Click="SettingsClick" AutomationProperties.Name="Abrir configurações">
                            <TextBlock Text="{x:Static ui:AppIcons.Settings}" Style="{StaticResource FluentIcon}" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="../Assets/ShadeFlow.ico" Width="22" Height="22" Margin="0,0,10,0" />
                        <TextBlock Text="ShadeFlow" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="18,16,14,2">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{x:Static ui:AppIcons.Presets}" Click="PresetsClick" Style="{StaticResource IconButton}" ToolTip="Criar e editar presets" AutomationProperties.Name="Gerenciar presets" />
                        <TextBlock Text="PRESETS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl x:Name="PresetButtons" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Width="44" Height="44" Padding="8" Margin="0,0,7,7" Click="PresetClick" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Name, StringFormat=Aplicar preset {0}}">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource FluentIcon}" FontSize="21" />
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Crie seu primeiro preset na página Presets." Margin="0,0,0,12">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=PresetButtons}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="MONITORES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ItemsControl x:Name="DisplayList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource ShadeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12,4,12">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding Description}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}%}" FontWeight="SemiBold" FontSize="16" Margin="12,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{Binding ResolutionDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,2" />
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            PreviewMouseLeftButtonDown="SliderInteractionStarted" LostMouseCapture="SliderInteractionFinished" AutomationProperties.Name="{Binding DisplayName, StringFormat=Brilho de {0}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aguardando monitores…" Margin="0,12">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=DisplayList}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="17,12,17,17">
                <Grid><Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock x:Name="AutomationIcon" Style="{StaticResource FluentIcon}" Margin="0,0,8,0" /><TextBlock x:Name="AutomationState" Grid.Column="1" motion:UiMotion.TextFeedback="True" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid><TextBlock x:Name="NextAdjustment" motion:UiMotion.TextFeedback="True" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="1" Content="{x:Static ui:AppIcons.Clock}" Style="{StaticResource IconButton}" ToolTip="Gerenciar automação" AutomationProperties.Name="Gerenciar automação" Margin="8,0,0,0" Click="ManageAutomationClick" />
                    <Button x:Name="ResumeAutomationButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Retomar automação" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResumeClick" AutomationProperties.Name="Retomar automação agora" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
