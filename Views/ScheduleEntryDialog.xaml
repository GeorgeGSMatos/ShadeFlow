<Window x:Class="ShadeFlow.Views.ScheduleEntryDialog"
        xmlns:motion="clr-namespace:ShadeFlow.Services" xmlns:ui="clr-namespace:ShadeFlow.Services" motion:UiMotion.Scope="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="../Assets/ShadeFlow.ico" Title="Horário de brilho" Style="{StaticResource DialogWindow}" Width="420" SizeToContent="Height" MinHeight="340" MaxHeight="650"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="{DynamicResource DialogPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static ui:AppIcons.Clock}" Style="{StaticResource FluentIcon}" Margin="0,0,12,0" /><TextBlock Text="Horário de brilho" Style="{StaticResource DialogHeading}" /></StackPanel>
            <TextBlock Text="Escolha quando o brilho deve mudar." Style="{StaticResource MutedText}" Margin="0,4,0,12" />
            <TextBlock Text="Horário (HH:mm)" />
        </StackPanel>
        <TextBox x:Name="TimeInput" Grid.Row="1" Margin="0,5,0,12" Width="120" HorizontalAlignment="Left" MaxLength="5" AutomationProperties.Name="Horário, horas e minutos" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Brilho (0–100)" />
            <TextBox x:Name="BrightnessInput" Margin="0,5,0,0" Width="120" HorizontalAlignment="Left" MaxLength="3" AutomationProperties.Name="Brilho de 0 a 100" />
        </StackPanel>

        <TextBlock x:Name="ValidationMessage" Grid.Row="3" MinHeight="40" Foreground="{DynamicResource ShadeErrorBrush}"
                   Margin="0,12,0,16" TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Salvar" Width="90" IsDefault="True" Click="SaveClick" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
